---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import gpusData from '../data/gpus.json';
import cpusData from '../data/cpus.json';
import gamesData from '../data/games.json';
---

<Layout title="Bottleneck Calculator - Find Your CPU or GPU Bottleneck" description="Find out if your CPU or GPU is holding your gaming performance back. Game-specific bottleneck analysis.">

<div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
  <div class="lg:col-span-2">
    <div class="card space-y-3">
      <h1 class="font-display text-xl font-semibold text-ink dark:text-dark-ink tracking-tight">Bottleneck Calculator</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray">Check if your CPU or GPU is limiting gaming performance.</p>
      <div>
        <label for="cpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">CPU</label>
        <input type="text" id="cpu-search" placeholder="Search CPU..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="cpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="gpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">GPU</label>
        <input type="text" id="gpu-search" placeholder="Search GPU..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="gpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="game" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">Game</label>
        <input type="text" id="game-search" placeholder="Search game..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="game" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="resolution" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">Resolution</label>
        <select id="resolution" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
          <option value="720p">720p</option>
          <option value="800p">800p</option>
          <option value="1080p" selected>1080p</option>
          <option value="1440p">1440p</option>
          <option value="4K">4K</option>
        </select>
      </div>
      <button id="calc-btn" class="w-full py-3 bg-ink dark:bg-dark-ink text-paper dark:text-dark-canvas rounded-pill text-sm font-medium cursor-pointer border-0 hover:scale-[1.02] transition-all duration-120">
        Analyze
      </button>
    </div>
  </div>

  <div class="lg:col-span-3">
    <div id="results-placeholder">
      <div id="bn-skeleton" class="card space-y-4 p-6">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text" style="width:70%"></div>
        <div class="skeleton skeleton-bar"></div>
        <div class="skeleton skeleton-bar"></div>
      </div>
      <div id="bn-empty" class="card flex flex-col items-center justify-center py-16 text-center hidden">
        <Icon name="lucide:gauge" size={48} class="text-hairline dark:text-dark-hairline mb-4" />
        <p class="text-mid-gray dark:text-dark-mid-gray text-sm">Select your CPU, GPU, and a game to analyze.</p>
      </div>
    </div>

    <div id="results" class="hidden space-y-4" aria-live="polite" tabindex="-1">
      <div class="card text-center">
        <div id="bottleneck-label" class="text-xs font-mono text-mid-gray dark:text-dark-mid-gray mb-1">BOTTLENECK AT <span id="bn-resolution" class="font-semibold">1080p</span></div>
        <div id="bottleneck-type" class="font-display text-4xl font-semibold text-ink dark:text-dark-ink tracking-[-0.03em]">--</div>
        <div id="bottleneck-pct" class="font-mono text-lg text-mid-gray dark:text-dark-mid-gray mt-1">0%</div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-4">Utilization Balance</h2>
        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-xs font-mono mb-1">
              <span class="text-ink dark:text-dark-ink">CPU Load</span>
              <span id="cpu-load-pct" class="text-mid-gray dark:text-dark-mid-gray">0%</span>
            </div>
            <div class="h-3 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
              <div id="cpu-bar" class="h-full bg-ink dark:bg-dark-ink rounded-full transition-all duration-700" style="width:0%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono mb-1">
              <span class="text-ink dark:text-dark-ink">GPU Load</span>
              <span id="gpu-load-pct" class="text-mid-gray dark:text-dark-mid-gray">0%</span>
            </div>
            <div class="h-3 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
              <div id="gpu-bar" class="h-full bg-mid-gray dark:bg-dark-mid-gray rounded-full transition-all duration-700" style="width:0%"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">Recommendations</h2>
        <div id="recommendations" class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed space-y-2"></div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="gpus-data" set:html={JSON.stringify(gpusData.gpus)}></script>
<script type="application/json" id="cpus-data" set:html={JSON.stringify(cpusData.cpus)}></script>
<script type="application/json" id="games-data" set:html={JSON.stringify(gamesData.games)}></script>

<script type="module">
import { setupFilteredSelect } from '../data/searchable-select.js';

const $ = (id) => document.getElementById(id);
let gpus = [], cpus = [], games = [];

async function loadData() {
  gpus = JSON.parse(document.getElementById('gpus-data').textContent);
  cpus = JSON.parse(document.getElementById('cpus-data').textContent);
  games = JSON.parse(document.getElementById('games-data').textContent);
}

function populate(selId, items, key) {
  const sel = $(selId);
  if (!sel) return;
  sel.innerHTML = `<option value="">Select</option>` + items.map((it, i) => `<option value="${i}">${it[key]}</option>`).join('');
}

(async () => {
  await loadData();
  populate('cpu', cpus, 'name');
  populate('gpu', gpus, 'name');
  populate('game', games, 'title');

  setupFilteredSelect('cpu-search', 'cpu', cpus, 'name');
  setupFilteredSelect('gpu-search', 'gpu', gpus, 'name');
  setupFilteredSelect('game-search', 'game', games, 'title');

  $('bn-skeleton')?.classList.add('hidden');
  $('bn-empty')?.classList.remove('hidden');

  $('calc-btn')?.addEventListener('click', analyze);
})();

function getVal(selId, items) {
  const sel = $(selId);
  return sel && sel.value !== '' ? items[parseInt(sel.value, 10)] : null;
}

async function analyze() {
  const cpu = getVal('cpu', cpus);
  const gpu = getVal('gpu', gpus);
  const game = getVal('game', games);
  if (!cpu || !gpu || !game) {
    $('bn-skeleton')?.classList.add('hidden');
    $('bn-empty')?.classList.remove('hidden');
    return;
  }

  const resolution = $('resolution')?.value || '1080p';
  const bn = window.RunFpsEngine.calculateBottleneck(cpu, gpu, game, resolution);

  $('results-placeholder').classList.add('hidden');
  $('results').classList.remove('hidden');
  $('results').focus();

  $('bn-resolution').textContent = resolution;
  $('bottleneck-type').textContent = `${bn.bottleneckType} Bottleneck`;
  $('bottleneck-type').style.color = bn.bottleneckType === 'CPU' ? '#e7000b' : bn.bottleneckType === 'GPU' ? '#0a0a0a' : '#737373';
  $('bottleneck-pct').textContent = `${bn.bottleneckPercent}%`;

  animateBar('cpu-bar', bn.cpuLoad);
  animateBar('gpu-bar', bn.gpuLoad);
  $('cpu-load-pct').textContent = `${bn.cpuLoad}%`;
  $('gpu-load-pct').textContent = `${bn.gpuLoad}%`;

  const recs = $('recommendations');
  recs.innerHTML = '';
  if (bn.bottleneckType === 'CPU') {
    recs.innerHTML = `<p>Your <strong>${cpu.name}</strong> is not keeping up with your <strong>${gpu.name}</strong> in <strong>${game.title}</strong> at ${resolution}.</p>
      <p>Consider upgrading to a faster CPU. An upgrade to a Ryzen 7 7800X3D or Core i7-14700K would significantly reduce this bottleneck.</p>
      <p>At lower resolutions (<strong>1080p or below</strong>), CPU bottlenecks are more pronounced. At ${resolution === '4K' ? 'this resolution' : '<strong>4K</strong>'}, the bottleneck will shift toward the GPU.</p>`;
  } else if (bn.bottleneckType === 'GPU') {
    recs.innerHTML = `<p>Your <strong>${gpu.name}</strong> is the primary limit in <strong>${game.title}</strong> at ${resolution}.</p>
      <p>Consider upgrading to a faster GPU. An upgrade to an RTX 4070 Super or better would significantly improve FPS.</p>
      <p>Lowering graphics settings or enabling DLSS/FSR will help reduce GPU load and improve FPS. At lower resolutions like <strong>720p</strong>, you may see a CPU bottleneck instead.</p>`;
  } else {
    recs.innerHTML = `<p>Your system is well-balanced for <strong>${game.title}</strong> at ${resolution}.</p>
      <p>No significant bottleneck detected. Enjoy smooth gameplay!</p>`;
  }
}

function animateBar(barId, value) {
  const bar = $(barId);
  if (bar) {
    bar.style.transition = 'none';
    bar.style.width = '0%';
    bar.offsetHeight;
    bar.style.transition = 'width 700ms ease-out';
    bar.style.width = `${Math.min(100, value)}%`;
  }
}
</script>

</Layout>
