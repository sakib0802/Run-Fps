---
import Layout from '../../layouts/Layout.astro';
import gamesData from '../../data/games.json';
import { Icon } from 'astro-icon/components';
import { genreBadgeGenres, genreColors, genreLabels } from '../../data/genres.js';
import { getProfile } from '../../data/profiles.js';

export async function getStaticPaths() {
  const games = gamesData.games;
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const profile = getProfile(game.id);

const tiers = [
  { name: "Budget", score: 65, gpu: "RTX 3060", cpu: "Ryzen 5 5600X" },
  { name: "Mid", score: 72, gpu: "RTX 4060", cpu: "Ryzen 5 7600X" },
  { name: "High", score: 82, gpu: "RTX 4070 Super", cpu: "Ryzen 7 7800X3D" },
  { name: "Enthusiast", score: 92, gpu: "RTX 4080 Super", cpu: "Ryzen 9 7950X3D" },
  { name: "Ultra", score: 100, gpu: "RTX 5090", cpu: "Core Ultra 9 285K" },
];

function getFpsAtScore(curve, score) {
  for (let i = 0; i < curve.length - 1; i++) {
    if (score >= curve[i].gpuScore && score <= curve[i + 1].gpuScore) {
      const t = (score - curve[i].gpuScore) / (curve[i + 1].gpuScore - curve[i].gpuScore);
      return Math.round(curve[i].fps + t * (curve[i + 1].fps - curve[i].fps));
    }
  }
  return score <= curve[0].gpuScore ? curve[0].fps : curve[curve.length - 1].fps;
}


const color = genreColors[game.genre] || "#737373";
const genreLabel = genreLabels[game.genre] || game.genre;
const curve = game.performanceCurve;
---

<Layout title={`${game.title} - FPS Estimates & System Requirements`} description={`Check FPS estimates for ${game.title} across 5 hardware tiers at 1080p and 1440p. System requirements: ${game.ramRequirement}GB RAM, ${game.vramRequirement}GB VRAM.`}>

<div class="py-6">
  <div class="flex items-center gap-3 flex-wrap">
    <span class={`badge${genreBadgeGenres.includes(game.genre)?` badge-${game.genre}`:''}`} style={genreBadgeGenres.includes(game.genre)?'':`background:${color}20;color:${color};border:1px solid ${color}40`}>{genreLabel}</span>
    <span class="badge capitalize ${game.optimizationTier === 'light' ? 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' : game.optimizationTier === 'medium' ? 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800' : 'bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800'}">${game.optimizationTier}</span>
    {game.steamDeck && <span class="badge bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">&#10003; Steam Deck Verified</span>}
    {game.dlss && <span class="badge bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">DLSS</span>}
    {game.fsr && <span class="badge bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">FSR</span>}
  </div>

  <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] text-ink dark:text-dark-ink leading-[1.1]">{game.title}</h1>
  <p class="mt-2 text-mid-gray dark:text-dark-mid-gray text-sm">{game.developer} &middot; {game.releaseYear}</p>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <div class="card">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink">FPS Estimates</h2>
        <p class="mt-1 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">Estimated frames per second across presets</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-hairline dark:border-dark-hairline">
                <th class="text-left py-2 pr-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">Tier</th>
                <th class="text-left py-2 px-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">Hardware</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">Low</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">Med</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">High</th>
                <th class="text-right py-2 pl-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">Ultra</th>
              </tr>
            </thead>
            <tbody>
              {tiers.map((tier) => {
                const fpsHigh = getFpsAtScore(curve, tier.score);
                const fpsLow = Math.round(fpsHigh * 1.4);
                const fpsMed = Math.round(fpsHigh * 1.15);
                const fpsUltra = Math.round(fpsHigh * 0.7);
                return (
                  <tr class="border-b border-hairline dark:border-dark-hairline last:border-0">
                    <td class="py-3 pr-4">
                      <span class="font-mono font-medium text-ink dark:text-dark-ink">{tier.name}</span>
                    </td>
                    <td class="py-3 px-4">
                      <span class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{tier.gpu} / {tier.cpu}</span>
                    </td>
                    <td class="py-3 px-2 text-right">
                      <span class="font-mono font-semibold text-ink dark:text-dark-ink">{fpsLow}</span>
                    </td>
                    <td class="py-3 px-2 text-right">
                      <span class="font-mono font-semibold text-ink dark:text-dark-ink">{fpsMed}</span>
                    </td>
                    <td class="py-3 px-2 text-right">
                      <span class="font-mono font-semibold text-ember">{fpsHigh}</span>
                    </td>
                    <td class="py-3 pl-4 text-right">
                      <span class="font-mono font-semibold text-ink dark:text-dark-ink">{fpsUltra}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <div class="card">
        <h2 class="font-display text-sm font-semibold text-ink dark:text-dark-ink">System Requirements</h2>
        <div class="mt-3 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">RAM</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium">{game.ramRequirement} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">VRAM</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium">{game.vramRequirement} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">Release Year</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium">{game.releaseYear}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">Developer</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium text-right">{game.developer}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">Optimization</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium capitalize">{game.optimizationTier}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">CPU Weight</span>
            <span class="text-sm font-mono text-ink dark:text-dark-ink font-medium">{Math.round(game.cpuWeight * 100)}%</span>
          </div>
        </div>
      </div>

      {profile && <div class="card">
        <h2 class="font-display text-sm font-semibold text-ink dark:text-dark-ink flex items-center gap-2"><Icon name="lucide:sliders-horizontal" size={16} class="text-ember" /> {profile.title}</h2>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <span class="badge bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">Target: {profile.target}</span>
          <span class="badge bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">{profile.focus}</span>
        </div>
        <ul class="mt-3 space-y-1.5">
          {profile.tips.map(tip => (
            <li class="text-xs text-mid-gray dark:text-dark-mid-gray flex items-start gap-2">
              <span class="text-ember shrink-0 mt-0.5">&bull;</span>
              <span class="flex-1">{tip.text}</span>
              {tip.impact && !tip.impact.includes('Baseline') && !tip.impact.includes('Stability') && !tip.impact.includes('Input') && !tip.impact.includes('Quality') && !tip.impact.includes('Accessibility')
                ? <span class="shrink-0 text-[10px] px-1.5 py-0.5 rounded font-mono font-medium bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">{tip.impact}</span>
                : tip.impact === 'Stability' || tip.impact === 'Input' || tip.impact === 'Accessibility'
                  ? <span class="shrink-0 text-[10px] px-1.5 py-0.5 rounded font-mono font-medium bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">{tip.impact}</span>
                  : <span class="shrink-0 text-[10px] px-1.5 py-0.5 rounded font-mono font-medium bg-gray-50 dark:bg-gray-900/30 text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline">{tip.impact}</span>
              }
            </li>
          ))}
        </ul>
      </div>}

      <div class="card">
        <h2 class="font-display text-sm font-semibold text-ink dark:text-dark-ink">Tech Support</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {game.steamDeck
            ? <span class="badge bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">&#10003; Steam Deck</span>
            : <span class="badge bg-gray-50 dark:bg-gray-900/30 text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline">&times; Steam Deck</span>
          }
          {game.dlss
            ? <span class="badge bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">DLSS</span>
            : <span class="badge bg-gray-50 dark:bg-gray-900/30 text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline">No DLSS</span>
          }
          {game.fsr
            ? <span class="badge bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">FSR</span>
            : <span class="badge bg-gray-50 dark:bg-gray-900/30 text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline">No FSR</span>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <a href="/games" class="inline-flex items-center gap-1.5 text-sm text-mid-gray dark:text-dark-mid-gray font-mono hover:text-ink dark:hover:text-dark-ink transition-colors duration-120">
      <Icon name="lucide:chevron-left" size={16} />
      Back to Games Library
    </a>
  </div>
</div>

</Layout>
