---
import Layout from '../../layouts/Layout.astro';
import gamesData from '../../data/games.json';
import { genreLabels, genreColors, genreList } from '../../data/genres.js';

const gameCount = gamesData.games.length;
---

<Layout title={`Games Library - Browse ${gameCount} Games FPS & System Requirements`} description={`Browse our library of ${gameCount} games. Check FPS estimates, system requirements, Steam Deck compatibility, and performance by hardware tier.`}>

<div class="py-6">
  <h1 class="font-display text-2xl sm:text-3xl font-semibold tracking-[-0.03em] text-ink dark:text-dark-ink">Games Library</h1>
  <p class="mt-1 text-sm text-mid-gray dark:text-dark-mid-gray">Check FPS estimates and system requirements for all {gameCount} games.</p>

  <div class="mt-4 flex flex-col sm:flex-row gap-3">
    <label for="game-search" class="sr-only">Search games</label>
    <input type="text" id="game-search" placeholder="Search games..." class="flex-1 px-4 py-2.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:ring-1 focus:ring-ember transition-colors duration-150" />
  </div>

  <div id="genre-filters" class="mt-3 flex flex-wrap gap-1 sm:gap-1.5">
    <button data-genre="all" class="genre-btn active px-2 py-0.5 sm:px-2.5 sm:py-1 text-xs font-mono rounded-pill border transition-all duration-120 cursor-pointer bg-ink dark:bg-dark-ink text-paper dark:text-dark-canvas border-ink dark:border-dark-ink" aria-pressed="true">All</button>
    {genreList.map(g => (
      <button data-genre={g} class="genre-btn px-2 py-0.5 sm:px-2.5 sm:py-1 text-xs font-mono rounded-pill border border-hairline dark:border-dark-hairline text-mid-gray dark:text-dark-mid-gray bg-paper dark:bg-dark-paper hover:border-mid-gray dark:hover:border-dark-mid-gray transition-all duration-120 cursor-pointer" aria-pressed="false">{genreLabels[g]}</button>
    ))}
  </div>

  <p id="result-count" class="mt-3 text-xs text-mid-gray dark:text-dark-mid-gray font-mono" aria-live="polite" aria-atomic="true"></p>

  <div id="games-grid" class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
  </div>

  <div id="see-more-container" class="mt-6 text-center hidden">
    <button id="see-more-btn" class="px-5 py-2 bg-canvas dark:bg-dark-paper text-ink dark:text-dark-ink text-sm font-medium rounded-pill border border-hairline dark:border-dark-hairline cursor-pointer hover:scale-[1.02] transition-all duration-120">Show more</button>
  </div>

  <div id="no-results" class="hidden mt-12 text-center">
    <p class="text-mid-gray dark:text-dark-mid-gray text-sm">No games match your search.</p>
  </div>
</div>

<script is:inline type="application/json" id="genre-data" set:html={JSON.stringify({ genreLabels, genreColors })}></script>
<script is:inline type="application/json" id="games-data" set:html={JSON.stringify(gamesData.games)}></script>

<script type="module">
const { genreLabels, genreColors } = JSON.parse(document.getElementById('genre-data').textContent);

let games = [];
let activeGenre = "all";
let searchQuery = "";
let visibleCount = 12;
const PAGE_SIZE = 12;

async function loadGames() {
  games = JSON.parse(document.getElementById('games-data').textContent);
  renderGames();
}

function renderGames() {
  const grid = document.getElementById('games-grid');
  const noResults = document.getElementById('no-results');
  const resultCount = document.getElementById('result-count');
  const seeMoreBtn = document.getElementById('see-more-btn');
  const seeMoreContainer = document.getElementById('see-more-container');
  if (!grid) return;

  const filtered = games.filter(g => {
    const matchGenre = activeGenre === "all" || g.genre === activeGenre;
    const matchSearch = g.title.toLowerCase().includes(searchQuery.toLowerCase());
    return matchGenre && matchSearch;
  });

  resultCount.textContent = filtered.length === games.length ? `${games.length} games` : `${filtered.length} of ${games.length} games`;

  if (filtered.length === 0) {
    grid.innerHTML = '';
    noResults.classList.remove('hidden');
    seeMoreContainer.classList.add('hidden');
    return;
  }
  noResults.classList.add('hidden');

  const show = filtered.slice(0, visibleCount);
  grid.innerHTML = show.map(g => `
    <a href="/games/${g.id}" class="card flex flex-col h-full no-underline group cursor-pointer">
      <div class="flex items-start justify-between gap-2">
        <h2 class="font-display font-medium text-base text-ink dark:text-dark-ink leading-snug truncate group-hover:text-ember transition-colors duration-120">${g.title}</h2>
        <span class="shrink-0 text-xs font-mono text-mid-gray dark:text-dark-mid-gray">${g.releaseYear}</span>
      </div>
      <div class="mt-1.5 flex items-center gap-1.5 flex-wrap">
        <span class="badge${['action','battle-royale','competitive-fps','horror','indie','mmo','moba','open-world','racing','rpg','sandbox','simulation','strategy','survival'].includes(g.genre)?` badge-${g.genre}`:''}" ${['action','battle-royale','competitive-fps','horror','indie','mmo','moba','open-world','racing','rpg','sandbox','simulation','strategy','survival'].includes(g.genre)?'':`style="background:${genreColors[g.genre] || '#737373'}20;color:${genreColors[g.genre] || '#737373'};border:1px solid ${genreColors[g.genre] || '#737373'}40"`}>${genreLabels[g.genre] || g.genre}</span>
        ${g.steamDeck ? '<span class="badge bg-cyan-50 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">SD</span>' : ''}
        <span class="badge ${g.optimizationTier === 'light' ? 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' : g.optimizationTier === 'medium' ? 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800' : 'bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800'} capitalize">${g.optimizationTier}</span>
      </div>
    </a>
  `).join('');

  if (filtered.length > visibleCount) {
    const remaining = filtered.length - visibleCount;
    seeMoreBtn.textContent = `Show more (${remaining})`;
    seeMoreContainer.classList.remove('hidden');
  } else {
    seeMoreContainer.classList.add('hidden');
  }
  visibleCount = Math.max(visibleCount, PAGE_SIZE);
}

(async () => {
  await loadGames();

  document.getElementById('game-search')?.addEventListener('input', (e) => {
    searchQuery = e.target.value;
    visibleCount = PAGE_SIZE;
    renderGames();
  });

  document.querySelectorAll('.genre-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.genre-btn').forEach(b => {
        b.classList.remove('bg-ink', 'dark:bg-dark-ink', 'text-paper', 'dark:text-dark-canvas', 'border-ink', 'dark:border-dark-ink');
        b.classList.add('border-hairline', 'dark:border-dark-hairline', 'text-mid-gray', 'dark:text-dark-mid-gray', 'bg-paper', 'dark:bg-dark-paper');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('border-hairline', 'dark:border-dark-hairline', 'text-mid-gray', 'dark:text-dark-mid-gray', 'bg-paper', 'dark:bg-dark-paper');
      btn.classList.add('bg-ink', 'dark:bg-dark-ink', 'text-paper', 'dark:text-dark-canvas', 'border-ink', 'dark:border-dark-ink');
      btn.setAttribute('aria-pressed', 'true');
      activeGenre = btn.dataset.genre;
      visibleCount = PAGE_SIZE;
      renderGames();
    });
  });

  document.getElementById('see-more-btn')?.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    renderGames();
  });
})();
</script>

</Layout>
