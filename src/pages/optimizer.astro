---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import gpusData from '../data/gpus.json';
import cpusData from '../data/cpus.json';
import gamesData from '../data/games.json';
---

<Layout title="Settings Optimizer - Optimize Your Game Settings for Target FPS" description="Set a target framerate and get a step-by-step settings guide to achieve it with minimal visual quality loss.">

<div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
  <div class="lg:col-span-2">
    <div class="card space-y-3">
      <h1 class="font-display text-xl font-semibold text-ink dark:text-dark-ink tracking-tight">Settings Optimizer</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray">Set a target FPS and find the best settings changes to get there.</p>

      <div>
        <label for="gpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">GPU</label>
        <input type="text" id="gpu-search" placeholder="Search GPU..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="gpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="cpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">CPU</label>
        <input type="text" id="cpu-search" placeholder="Search CPU..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="cpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="game" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">Game</label>
        <input type="text" id="game-search" placeholder="Search game..." class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
        <select id="game" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
      </div>
      <div>
        <label for="target-fps" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">Target FPS</label>
        <select id="target-fps" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
          <option value="60">60 FPS</option>
          <option value="120">120 FPS</option>
          <option value="144" selected>144 FPS</option>
          <option value="240">240 FPS</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <div id="custom-fps-container" class="hidden">
        <label for="custom-fps" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">Custom Target FPS</label>
        <input type="number" id="custom-fps" placeholder="Enter target FPS" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none" />
      </div>

      <button id="optimize-btn" class="w-full py-3 bg-ink dark:bg-dark-ink text-paper dark:text-dark-canvas rounded-pill text-sm font-medium cursor-pointer border-0 hover:scale-[1.02] transition-all duration-120">
        Optimize
      </button>
    </div>
  </div>

  <div class="lg:col-span-3">
    <div id="optimizer-results" class="hidden space-y-4" aria-live="polite" tabindex="-1">
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <div>
            <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono mb-1">CURRENT FPS</div>
            <div id="current-fps-display" class="font-display text-3xl font-semibold text-ink dark:text-dark-ink tracking-[-0.03em]">0</div>
          </div>
          <div class="text-right">
            <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono mb-1">TARGET FPS</div>
            <div id="target-fps-display" class="font-display text-3xl font-semibold text-ink dark:text-dark-ink tracking-[-0.03em]">0</div>
          </div>
        </div>
        <div class="h-3 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
          <div id="fps-progress" class="h-full bg-ink-soft dark:bg-dark-ink-soft rounded-full transition-all duration-700" style="width:0%"></div>
        </div>
        <div id="optimizer-verdict" class="mt-3 text-sm font-mono"></div>
      </div>

      <div id="optimizer-changes" class="hidden" aria-live="polite">
        <div class="card">
          <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">Recommended Changes</h2>
          <div id="changes-table" class="space-y-2"></div>
          <div class="mt-4 pt-4 border-t border-hairline dark:border-dark-hairline">
            <div class="flex justify-between text-sm font-mono">
              <span class="text-mid-gray dark:text-dark-mid-gray">Projected FPS</span>
              <span id="final-fps-display" class="font-medium text-ink dark:text-dark-ink">0</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="optimizer-placeholder">
      <div id="opt-skeleton" class="card space-y-4 p-6">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text" style="width:80%"></div>
        <div class="skeleton skeleton-bar"></div>
        <div class="skeleton skeleton-text" style="width:55%"></div>
        <div class="skeleton skeleton-bar"></div>
      </div>
      <div id="opt-empty" class="card flex flex-col items-center justify-center py-16 text-center hidden">
        <Icon name="lucide:settings" size={48} class="text-hairline dark:text-dark-hairline mb-4" />
        <p class="text-mid-gray dark:text-dark-mid-gray text-sm">Select your hardware, a game, and a target FPS to optimize.</p>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="gpus-data" set:html={JSON.stringify(gpusData.gpus)}></script>
<script type="application/json" id="cpus-data" set:html={JSON.stringify(cpusData.cpus)}></script>
<script type="application/json" id="games-data" set:html={JSON.stringify(gamesData.games)}></script>

<script type="module">
import { setupFilteredSelect } from '../data/searchable-select.js';

const $ = (id) => document.getElementById(id);
let gpus = [], cpus = [], games = [];

async function loadData() {
  gpus = JSON.parse(document.getElementById('gpus-data').textContent);
  cpus = JSON.parse(document.getElementById('cpus-data').textContent);
  games = JSON.parse(document.getElementById('games-data').textContent);
}

function populate(selId, items, key) {
  const sel = $(selId);
  if (!sel) return;
  sel.innerHTML = `<option value="">Select</option>` + items.map((it, i) => `<option value="${i}">${it[key]}</option>`).join('');
}

(async () => {
  await loadData();
  populate('gpu', gpus, 'name');
  populate('cpu', cpus, 'name');
  populate('game', games, 'title');

  setupFilteredSelect('gpu-search', 'gpu', gpus, 'name');
  setupFilteredSelect('cpu-search', 'cpu', cpus, 'name');
  setupFilteredSelect('game-search', 'game', games, 'title');

  $('opt-skeleton')?.classList.add('hidden');
  $('opt-empty')?.classList.remove('hidden');

  $('target-fps')?.addEventListener('change', () => {
    $('custom-fps-container').classList.toggle('hidden', $('target-fps').value !== 'custom');
  });

  $('optimize-btn')?.addEventListener('click', optimize);
})();

function getVal(selId, items) {
  const sel = $(selId);
  return sel && sel.value !== '' ? items[parseInt(sel.value, 10)] : null;
}

async function optimize() {
  let gpu = getVal('gpu', gpus);
  const cpu = getVal('cpu', cpus);
  const game = getVal('game', games);
  let target = $('target-fps').value === 'custom'
    ? Math.max(1, Math.min(1000, parseInt($('custom-fps').value, 10) || 144))
    : parseInt($('target-fps').value, 10);

  if (!cpu || !game) {
    $('optimizer-placeholder').classList.remove('hidden');
    $('opt-skeleton')?.classList.add('hidden');
    $('opt-empty')?.classList.remove('hidden');
    $('optimizer-results').classList.add('hidden');
    return;
  }

  if (!gpu && cpu.igpuScore) {
    gpu = { name: cpu.name + ' iGPU', score: cpu.igpuScore, vram: cpu.igpuScore >= 20 ? 4 : cpu.igpuScore >= 10 ? 2 : 1, brand: cpu.brand };
  }

  if (!gpu) {
    $('optimizer-placeholder').classList.remove('hidden');
    $('opt-skeleton')?.classList.add('hidden');
    $('opt-empty')?.classList.remove('hidden');
    $('optimizer-results').classList.add('hidden');
    return;
  }

  const config = { ramCapacity: 16, ramType: 'ddr5', ramSpeed: 6000, ramChannel: 'dual', storage: 'nvme', resolution: '1080p', preset: 'high', rtEnabled: false, upscaling: 'none', resolutionScale: 100, frameCap: 0, monitorHz: 144, vramLimit: 0 };
  const result = window.RunFpsEngine.calculateFPS(config, game, gpu, cpu);
  const opt = window.RunFpsEngine.optimizeSettings(result.avgFps, target, game, result);

  $('optimizer-placeholder').classList.add('hidden');
  $('optimizer-results').classList.remove('hidden');
  $('optimizer-results').focus();
  $('current-fps-display').textContent = result.avgFps;
  $('target-fps-display').textContent = target;

  const progress = Math.min(100, Math.round((result.avgFps / target) * 100));
  $('fps-progress').style.width = `${progress}%`;

  if (opt.canReach) {
    $('optimizer-verdict').textContent = opt.changes.length > 0
      ? `✓ Target achievable with ${opt.changes.length} setting change(s). Quality impact: ${opt.qualityImpact}%`
      : '✓ Target already achievable at current settings. No changes needed.';
    $('optimizer-verdict').style.color = '#171717';
  } else {
    $('optimizer-verdict').textContent = `✗ Cannot reach ${target} FPS with current hardware. Best achievable: ${opt.finalFps} FPS. Consider upgrading your GPU.`;
    $('optimizer-verdict').style.color = '#a00000';
  }

  if (opt.canReach && opt.changes.length > 0) {
    $('optimizer-changes').classList.remove('hidden');
    const table = $('changes-table');
    table.innerHTML = '';
    opt.changes.forEach((ch, i) => {
      table.innerHTML += `
        <div class="flex items-center justify-between py-2 px-3 bg-canvas dark:bg-dark-canvas rounded-lg" style="animation:fade-in-up 200ms ${i * 50}ms both">
          <div>
            <span class="text-sm font-mono text-ink dark:text-dark-ink capitalize">${ch.setting.replace(/_/g, ' ')}</span>
            <span class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono ml-2">${ch.from} → ${ch.to}</span>
          </div>
          <span class="text-sm font-mono text-ink dark:text-dark-ink">+${ch.gain} FPS</span>
        </div>`;
    });
    $('final-fps-display').textContent = `${opt.finalFps} FPS`;
  } else {
    $('optimizer-changes').classList.add('hidden');
  }
}
</script>

</Layout>
