---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    id: "accuracy",
    question: "How accurate are the FPS estimates?",
    answer: "FPS estimates are based on GPU and CPU benchmark scores interpolated against real game performance data. Actual FPS may vary by ±10-15% depending on your specific system configuration, drivers, background processes, and other factors. We recommend using the estimates as a general guide rather than an exact prediction."
  },
  {
    id: "calculation",
    question: "How does the FPS calculation work?",
    answer: "Each GPU and CPU has a benchmark score (0-100). Each game has a performance curve mapping GPU scores to FPS. We combine this with your CPU score, RAM configuration, resolution, quality preset, and other settings to estimate your FPS. All calculations run locally in your browser &mdash; no data is sent anywhere."
  },
  {
    id: "signup",
    question: "Do I need to sign up or pay?",
    answer: "No. Everything is completely free. No signup, no account, no premium tiers. Just show up and use it."
  },
  {
    id: "upgrades",
    question: "Can I trust the upgrade suggestions?",
    answer: "Upgrade suggestions are based purely on benchmark score comparisons. We show GPUs with higher scores than your current one and estimate the FPS gain. Actual performance uplift depends on your full system, but the relative ranking is a reliable indicator."
  },
  {
    id: "comparison",
    question: "How do you compare GPUs and CPUs?",
    answer: "Hardware is ranked by a composite benchmark score (0-100) based on real-world gaming performance. You can compare specs side by side and see estimated FPS differences across popular games using a standardized test system."
  },
  {
    id: "can-it-run",
    question: "Can my PC run a specific game?",
    answer: 'Use the <a href="/calculator" class="text-ink dark:text-dark-ink underline underline-offset-2 hover:text-ember transition-colors duration-120">FPS Calculator</a> &mdash; select your GPU, CPU, and the game to see estimated FPS at different presets and resolutions. You can also check the <a href="/games" class="text-ink dark:text-dark-ink underline underline-offset-2 hover:text-ember transition-colors duration-120">Games Library</a> for per-game FPS estimates across hardware tiers.'
  },
  {
    id: "system-reqs",
    question: "What are system requirements?",
    answer: 'Each game page in the <a href="/games" class="text-ink dark:text-dark-ink underline underline-offset-2 hover:text-ember transition-colors duration-120">Games Library</a> includes RAM, VRAM, and storage requirements. You can also see estimated FPS across budget to ultra hardware tiers to know exactly what to expect.'
  },
  {
    id: "laptop",
    question: "Will my laptop run these games?",
    answer: 'If your laptop has a dedicated GPU, you can look it up in our database. Select your laptop\'s GPU and CPU in the <a href="/calculator" class="text-ink dark:text-dark-ink underline underline-offset-2 hover:text-ember transition-colors duration-120">FPS Calculator</a> to get estimates. Note that laptop GPUs typically perform slightly below their desktop counterparts due to thermal and power limits.'
  },
  {
    id: "updates",
    question: "How often is the data updated?",
    answer: "New GPUs, CPUs, and games are added regularly. Game performance data is updated to reflect patches and driver improvements. Check back often for the latest additions."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<[^>]*>/g, '')
    }
  }))
};
---

<Layout title="FAQ - Frequently Asked Questions" description="Answers to common questions about RunFps FPS estimates, calculations, and features.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">FAQ</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray mt-1">Answers to common questions.</p>
    </div>

    <div class="space-y-2">
      {faqs.map(faq => (
        <div class="faq-item rounded-lg border border-hairline dark:border-dark-hairline bg-paper dark:bg-dark-paper">
          <h2>
            <button
              id={"faq-btn-" + faq.id}
              aria-expanded="false"
              aria-controls={"faq-panel-" + faq.id}
              class="w-full flex items-center justify-between gap-3 text-sm font-medium text-ink dark:text-dark-ink cursor-pointer py-3 px-4 bg-transparent border-0 rounded-lg text-left transition-colors duration-120 hover:bg-hairline/30 dark:hover:bg-dark-hairline/30"
            >
              <span>{faq.question}</span>
              <svg class="chevron w-4 h-4 text-mid-gray dark:text-dark-mid-gray shrink-0 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </h2>
          <div
            id={"faq-panel-" + faq.id}
            role="region"
            aria-labelledby={"faq-btn-" + faq.id}
            class="faq-panel text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed px-4 pb-3 hidden"
          >
            <!-- set:html required — faq.answer contains inline <a> links to /calculator, /games -->
            <span set:html={faq.answer} />
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    document.querySelectorAll('.faq-item').forEach(function(item) {
      var btn = item.querySelector('button');
      var panel = item.querySelector('.faq-panel');

      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !expanded);
        panel.classList.toggle('hidden', expanded);
      });
    });
  </script>
</Layout>
