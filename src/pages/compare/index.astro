---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { gpus } from '../../data/gpus.json';
import { cpus } from '../../data/cpus.json';
import { games } from '../../data/games.json';

const sortedGpus = [...gpus].sort((a, b) => b.score - a.score);
const sortedCpus = [...cpus].sort((a, b) => b.score - a.score);
const topGames = games.slice(0, 10);
const refCpu = { id: 'ryzen-7-7800x3d', name: 'Ryzen 7 7800X3D', brand: 'amd', score: 92 };
const refGpu = { id: 'rtx-4090', name: 'RTX 4090', brand: 'nvidia', score: 96, vram: 24 };
---

<Layout title="GPU & CPU Comparison - Compare Hardware Side by Side" description="Compare any two GPUs or CPUs side by side with specs, benchmark scores, and FPS in popular games.">

<script type="application/json" id="compare-gpus" set:html={JSON.stringify(sortedGpus)}></script>
<script type="application/json" id="compare-cpus" set:html={JSON.stringify(sortedCpus)}></script>
<script type="application/json" id="compare-games" set:html={JSON.stringify(topGames)}></script>
<script type="application/json" id="compare-refs" set:html={JSON.stringify({ refCpu, refGpu })}></script>

<div class="space-y-6">
  <div>
    <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">Hardware Comparison</h1>
    <p class="text-sm text-mid-gray dark:text-dark-mid-gray mt-1">Compare any two GPUs or CPUs side by side.</p>
  </div>

  <div class="flex gap-2" role="tablist" aria-label="Compare type">
    <button id="tab-gpu" class="compare-tab flex-1 sm:flex-none px-6 py-2 text-sm font-medium rounded-pill cursor-pointer transition-all duration-120" role="tab" aria-selected="true" aria-controls="panel-gpu" tabindex="0">GPU vs GPU</button>
    <button id="tab-cpu" class="compare-tab flex-1 sm:flex-none px-6 py-2 text-sm font-medium rounded-pill cursor-pointer transition-all duration-120" role="tab" aria-selected="false" aria-controls="panel-cpu" tabindex="-1">CPU vs CPU</button>
  </div>

  <div id="panel-gpu" role="tabpanel" aria-labelledby="tab-gpu">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="card">
        <label class="block text-sm font-medium text-ink dark:text-dark-ink mb-2">GPU 1</label>
        <button id="trigger-gpu-1" class="trigger-btn w-full text-left px-4 py-3 text-sm rounded-pill border border-hairline dark:border-dark-hairline bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray cursor-pointer hover:border-ember dark:hover:border-ember transition-all duration-120 flex items-center justify-between gap-2" data-selected="false">
          <span id="label-gpu-1" class="truncate">Select GPU 1</span>
          <Icon name="lucide:chevron-down" size={16} class="chevron shrink-0 text-mid-gray dark:text-dark-mid-gray transition-transform duration-200" />
        </button>
      </div>
      <div class="card">
        <label class="block text-sm font-medium text-ink dark:text-dark-ink mb-2">GPU 2</label>
        <button id="trigger-gpu-2" class="trigger-btn w-full text-left px-4 py-3 text-sm rounded-pill border border-hairline dark:border-dark-hairline bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray cursor-pointer hover:border-ember dark:hover:border-ember transition-all duration-120 flex items-center justify-between gap-2" data-selected="false">
          <span id="label-gpu-2" class="truncate">Select GPU 2</span>
          <Icon name="lucide:chevron-down" size={16} class="chevron shrink-0 text-mid-gray dark:text-dark-mid-gray transition-transform duration-200" />
        </button>
      </div>
    </div>
  </div>

  <div id="panel-cpu" role="tabpanel" aria-labelledby="tab-cpu" class="hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="card">
        <label class="block text-sm font-medium text-ink dark:text-dark-ink mb-2">CPU 1</label>
        <button id="trigger-cpu-1" class="trigger-btn w-full text-left px-4 py-3 text-sm rounded-pill border border-hairline dark:border-dark-hairline bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray cursor-pointer hover:border-ember dark:hover:border-ember transition-all duration-120 flex items-center justify-between gap-2" data-selected="false">
          <span id="label-cpu-1" class="truncate">Select CPU 1</span>
          <Icon name="lucide:chevron-down" size={16} class="chevron shrink-0 text-mid-gray dark:text-dark-mid-gray transition-transform duration-200" />
        </button>
      </div>
      <div class="card">
        <label class="block text-sm font-medium text-ink dark:text-dark-ink mb-2">CPU 2</label>
        <button id="trigger-cpu-2" class="trigger-btn w-full text-left px-4 py-3 text-sm rounded-pill border border-hairline dark:border-dark-hairline bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray cursor-pointer hover:border-ember dark:hover:border-ember transition-all duration-120 flex items-center justify-between gap-2" data-selected="false">
          <span id="label-cpu-2" class="truncate">Select CPU 2</span>
          <Icon name="lucide:chevron-down" size={16} class="chevron shrink-0 text-mid-gray dark:text-dark-mid-gray transition-transform duration-200" />
        </button>
      </div>
    </div>
  </div>

  <div id="duplicate-notification" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 bg-paper dark:bg-dark-paper text-mid-gray dark:text-dark-mid-gray text-sm font-medium rounded-pill border border-hairline dark:border-dark-hairline shadow-lg transition-all duration-300" role="alert"></div>

  <!-- Inline selector panel -->
  <div id="selector-panel" class="hidden card p-4 sm:p-5">
    <div class="flex items-center justify-between mb-4">
      <span id="selector-panel-title" class="font-display text-sm font-semibold text-ink dark:text-dark-ink">Select</span>
      <button id="selector-panel-close" class="w-7 h-7 flex items-center justify-center rounded-pill text-mid-gray dark:text-dark-mid-gray hover:text-ink dark:hover:text-dark-ink hover:bg-hairline/50 dark:hover:bg-dark-hairline/50 transition-all duration-120 cursor-pointer" aria-label="Close">
        <Icon name="lucide:x" size={15} />
      </button>
    </div>

    <input type="text" id="selector-panel-search" placeholder="Search..." aria-label="Search hardware" class="w-full px-4 py-2 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember dark:focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />

    <div id="selector-panel-filters" class="flex gap-2 mt-3 flex-wrap"></div>

    <div id="selector-panel-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4 max-h-72 overflow-y-auto"></div>
  </div>

  <div id="compare-results" class="hidden space-y-6" aria-live="polite" tabindex="-1">
    <div class="card">
      <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink mb-4">Specs Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="specs-table">
          <thead>
            <tr class="border-b border-hairline dark:border-dark-hairline">
              <th scope="col" class="text-left py-2 pr-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray font-medium">Spec</th>
              <th scope="col" id="header-1" class="text-right px-2 py-2 font-display text-sm font-semibold text-ink dark:text-dark-ink"></th>
              <th scope="col" id="header-2" class="text-right px-2 py-2 font-display text-sm font-semibold text-ink dark:text-dark-ink"></th>
            </tr>
          </thead>
          <tbody id="specs-body"></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink mb-4">FPS in Popular Games (1080p High)</h2>
      <p id="fps-subtitle" class="text-xs text-mid-gray dark:text-dark-mid-gray mb-4 font-mono"></p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="fps-table">
          <thead>
            <tr class="border-b border-hairline dark:border-dark-hairline">
              <th scope="col" class="text-left py-2 pr-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray font-medium">Game</th>
              <th scope="col" id="fps-header-1" class="text-right px-2 py-2 font-display text-sm font-semibold text-ink dark:text-dark-ink"></th>
              <th scope="col" id="fps-header-2" class="text-right px-2 py-2 font-display text-sm font-semibold text-ink dark:text-dark-ink"></th>
            </tr>
          </thead>
          <tbody id="fps-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script type="module">
const gpus = JSON.parse(document.getElementById('compare-gpus').textContent);
const cpus = JSON.parse(document.getElementById('compare-cpus').textContent);
const games = JSON.parse(document.getElementById('compare-games').textContent);
const refs = JSON.parse(document.getElementById('compare-refs').textContent);

let activeMode = 'gpu';
let activeSlot = 1;
let activeBrand = '';
const selections = { gpu: { 1: null, 2: null }, cpu: { 1: null, 2: null } };

const ACTIVE = 'bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0';
const INACTIVE = 'bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline';

function setActiveTab(tab) {
  document.querySelectorAll('.compare-tab').forEach(t => {
    t.className = `compare-tab flex-1 sm:flex-none px-6 py-2 text-sm font-medium rounded-pill cursor-pointer transition-all duration-120`;
    t.classList.add(...(t === tab ? ACTIVE.split(' ') : INACTIVE.split(' ')));
    t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
    t.tabIndex = t === tab ? 0 : -1;
  });
}

function switchMode(mode) {
  activeMode = mode;
  const tab = document.getElementById(mode === 'gpu' ? 'tab-gpu' : 'tab-cpu');
  setActiveTab(tab);
  document.getElementById('panel-gpu').classList.toggle('hidden', mode !== 'gpu');
  document.getElementById('panel-cpu').classList.toggle('hidden', mode !== 'cpu');
  hidePanel();

  const s1 = selections[activeMode][1];
  const s2 = selections[activeMode][2];
  if (s1 && s2) compare();

  const params = new URLSearchParams(location.search);
  params.set('mode', mode);
  history.replaceState(null, '', `${location.pathname}?${params}`);
}

function renderPanelFilters() {
  const brands = activeMode === 'gpu' ? ['nvidia', 'amd', 'intel'] : ['amd', 'intel'];
  const container = document.getElementById('selector-panel-filters');
  container.innerHTML = `<button class="panel-filter px-3 py-1 text-xs font-medium rounded-pill cursor-pointer transition-all duration-120 ${ACTIVE}" data-brand="">All</button>` +
    brands.map(b => `<button class="panel-filter px-3 py-1 text-xs font-medium rounded-pill cursor-pointer transition-all duration-120 ${INACTIVE}" data-brand="${b}">${b.charAt(0).toUpperCase() + b.slice(1)}</button>`).join('');
}

function renderPanelCards() {
  const items = activeMode === 'gpu' ? gpus : cpus;
  const search = document.getElementById('selector-panel-search').value.toLowerCase();
  const grid = document.getElementById('selector-panel-grid');

  const filtered = items.filter(item => {
    if (search && !item.name.toLowerCase().includes(search)) return false;
    if (activeBrand && item.brand !== activeBrand) return false;
    return true;
  });

  if (filtered.length === 0) {
    grid.innerHTML = '<p class="text-sm text-mid-gray dark:text-dark-mid-gray col-span-full text-center py-8">No hardware matches your search.</p>';
    return;
  }

  grid.innerHTML = filtered.map(item => {
    const idx = items.indexOf(item);
    const badgeStyle = item.brand === 'nvidia' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : item.brand === 'amd' ? 'bg-ember/10 text-ember' : 'bg-blue-500/10 text-blue-600 dark:text-blue-400';
    return `<button class="panel-card text-left w-full p-3 rounded-lg border border-hairline dark:border-dark-hairline bg-paper dark:bg-dark-paper hover:border-ember dark:hover:border-ember hover:bg-ember/5 dark:hover:bg-ember/5 transition-all duration-120 cursor-pointer" data-index="${idx}">
      <div class="font-medium text-sm text-ink dark:text-dark-ink">${item.name}</div>
      <div class="flex items-center gap-2 mt-1.5">
        <span class="font-mono text-xs text-mid-gray dark:text-dark-mid-gray">${item.score}/100</span>
        <span class="text-xs px-1.5 py-0.5 rounded font-medium ${badgeStyle}">${item.brand}</span>
      </div>
    </button>`;
  }).join('');
}

function showPanel() {
  document.getElementById('selector-panel').classList.remove('hidden');
  document.getElementById('selector-panel-search').focus();
}

function hidePanel() {
  document.getElementById('selector-panel').classList.add('hidden');
}

function togglePanel(mode, slot) {
  const wasOpen = !document.getElementById('selector-panel').classList.contains('hidden') && activeMode === mode && activeSlot === slot;
  hidePanel();
  if (wasOpen) return;
  activeMode = mode;
  activeSlot = slot;
  activeBrand = '';
  document.getElementById('selector-panel-title').textContent = `Select ${mode.toUpperCase()} ${slot}`;
  document.getElementById('selector-panel-search').value = '';
  renderPanelFilters();
  renderPanelCards();
  showPanel();
}

function selectItem(idx) {
  const items = activeMode === 'gpu' ? gpus : cpus;
  const item = items[idx];
  const otherSlot = activeSlot === 1 ? 2 : 1;
  const otherItem = selections[activeMode][otherSlot];
  if (otherItem && otherItem.id === item.id) {
    const n = document.getElementById('duplicate-notification');
    n.textContent = `${item.name} is already selected in ${activeMode.toUpperCase()} ${otherSlot}.`;
    n.classList.remove('hidden');
    setTimeout(() => n.classList.add('hidden'), 3000);
    return;
  }
  selections[activeMode][activeSlot] = item;

  const label = document.getElementById(`label-${activeMode}-${activeSlot}`);
  const btn = document.getElementById(`trigger-${activeMode}-${activeSlot}`);
  label.textContent = item.name;
  btn.dataset.selected = 'true';
  btn.className = `trigger-btn w-full text-left px-4 py-3 text-sm rounded-pill border border-hairline dark:border-dark-hairline bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink font-medium cursor-pointer hover:border-ember dark:hover:border-ember transition-all duration-120 flex items-center justify-between gap-2`;

  hidePanel();

  const s1 = selections[activeMode][1];
  const s2 = selections[activeMode][2];
  if (s1 && s2) compare();
}

function compare() {
  const isGpu = activeMode === 'gpu';
  const item1 = selections[activeMode][1];
  const item2 = selections[activeMode][2];
  if (!item1 || !item2) return;

  const config = { ramCapacity: 16, ramType: 'ddr5', ramSpeed: 6000, ramChannel: 'dual', storage: 'nvme', resolution: '1080p', preset: 'high', rtEnabled: false, upscaling: 'none', resolutionScale: 100, frameCap: 0, monitorHz: 144, vramLimit: 0 };

  const refHardware = isGpu ? refs.refCpu : refs.refGpu;
  document.getElementById('fps-subtitle').textContent = `Using ${refHardware.name}, 16GB DDR5-6000, NVMe.`;

  const cr = document.getElementById('compare-results');
  cr.classList.remove('hidden');
  cr.focus();

  document.getElementById('header-1').textContent = item1.name;
  document.getElementById('header-2').textContent = item2.name;
  document.getElementById('fps-header-1').textContent = item1.name;
  document.getElementById('fps-header-2').textContent = item2.name;

  let specs;
  if (isGpu) {
    specs = [
      { label: 'Score', v1: item1.score, v2: item2.score, unit: '/100', higher: true },
      { label: 'VRAM', v1: item1.vram, v2: item2.vram, unit: ' GB', higher: true },
      { label: 'TDP', v1: item1.tdp, v2: item2.tdp, unit: 'W', higher: false },
      { label: 'Launch Year', v1: item1.launchYear, v2: item2.launchYear, unit: '', higher: true },
      { label: 'Generation', v1: item1.generation, v2: item2.generation, unit: '', higher: null },
      { label: 'Tier', v1: item1.tier, v2: item2.tier, unit: '', higher: null },
    ];
  } else {
    specs = [
      { label: 'Score', v1: item1.score, v2: item2.score, unit: '/100', higher: true },
      { label: 'Cores', v1: item1.cores, v2: item2.cores, unit: '', higher: true },
      { label: 'Threads', v1: item1.threads, v2: item2.threads, unit: '', higher: true },
      { label: 'TDP', v1: item1.tdp, v2: item2.tdp, unit: 'W', higher: false },
      { label: 'Launch Year', v1: item1.launchYear, v2: item2.launchYear, unit: '', higher: true },
      { label: 'Generation', v1: item1.generation, v2: item2.generation, unit: '', higher: null },
      { label: 'Tier', v1: item1.tier, v2: item2.tier, unit: '', higher: null },
    ];
  }

  const specsBody = document.getElementById('specs-body');
  specsBody.innerHTML = specs.map(s => {
    const isNum = typeof s.v1 === 'number' && typeof s.v2 === 'number';
    let winner = '';
    if (isNum && s.higher !== null) {
      winner = s.v1 > s.v2 ? '1' : s.v2 > s.v1 ? '2' : '';
    }
    const val1 = `${s.v1}${s.unit}`;
    const val2 = `${s.v2}${s.unit}`;
    return `<tr class="border-b border-hairline dark:border-dark-hairline">
      <td class="py-2 pr-4 text-mid-gray dark:text-dark-mid-gray font-mono text-xs">${s.label}</td>
      <td class="text-right px-2 py-2 font-mono text-sm ${winner === '1' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : winner === '2' ? 'text-mid-gray' : 'text-ink dark:text-dark-ink'}">${val1}${winner === '1' ? '<span class="sr-only"> (better)</span>' : ''}</td>
      <td class="text-right px-2 py-2 font-mono text-sm ${winner === '2' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : winner === '1' ? 'text-mid-gray' : 'text-ink dark:text-dark-ink'}">${val2}${winner === '2' ? '<span class="sr-only"> (better)</span>' : ''}</td>
    </tr>`;
  }).join('');

  const fpsBody = document.getElementById('fps-body');
  fpsBody.innerHTML = '';
  for (const game of games) {
    let r1, r2;
    if (isGpu) {
      r1 = window.RunFpsEngine.calculateFPS(config, game, item1, refs.refCpu);
      r2 = window.RunFpsEngine.calculateFPS(config, game, item2, refs.refCpu);
    } else {
      r1 = window.RunFpsEngine.calculateFPS(config, game, refs.refGpu, item1);
      r2 = window.RunFpsEngine.calculateFPS(config, game, refs.refGpu, item2);
    }
    const winner = r1.avgFps > r2.avgFps ? '1' : r2.avgFps > r1.avgFps ? '2' : '';
    fpsBody.innerHTML += `<tr class="border-b border-hairline dark:border-dark-hairline">
      <td class="py-2 pr-4 text-ink dark:text-dark-ink font-medium" scope="row">${game.title}</td>
      <td class="text-right px-2 py-2 font-mono text-sm ${winner === '1' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : 'text-mid-gray'}">${r1.avgFps}${winner === '1' ? '<span class="sr-only"> (better)</span>' : ''}</td>
      <td class="text-right px-2 py-2 font-mono text-sm ${winner === '2' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : 'text-mid-gray'}">${r2.avgFps}${winner === '2' ? '<span class="sr-only"> (better)</span>' : ''}</td>
    </tr>`;
  }

  cr.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// --- Init ---
setActiveTab(document.getElementById('tab-gpu'));

// Trigger button clicks
document.querySelectorAll('.trigger-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const parts = btn.id.split('-');
    togglePanel(parts[1], parseInt(parts[2], 10));
  });
});

// Tab click handlers
document.getElementById('tab-gpu').addEventListener('click', () => switchMode('gpu'));
document.getElementById('tab-cpu').addEventListener('click', () => switchMode('cpu'));

// Tab keyboard nav
document.getElementById('tab-gpu').addEventListener('keydown', e => {
  if (e.key === 'ArrowRight') { e.preventDefault(); switchMode('cpu'); document.getElementById('tab-cpu').focus(); }
});
document.getElementById('tab-cpu').addEventListener('keydown', e => {
  if (e.key === 'ArrowLeft') { e.preventDefault(); switchMode('gpu'); document.getElementById('tab-gpu').focus(); }
});

// Panel close
document.getElementById('selector-panel-close').addEventListener('click', hidePanel);

// Panel search
document.getElementById('selector-panel-search').addEventListener('input', renderPanelCards);

// Panel filters (delegated — buttons are dynamic)
document.getElementById('selector-panel-filters').addEventListener('click', e => {
  const btn = e.target.closest('.panel-filter');
  if (!btn) return;
  document.querySelectorAll('.panel-filter').forEach(b => {
    b.className = `panel-filter px-3 py-1 text-xs font-medium rounded-pill cursor-pointer transition-all duration-120 ${b === btn ? ACTIVE : INACTIVE}`;
  });
  activeBrand = btn.dataset.brand;
  renderPanelCards();
});

// Panel card selection
document.getElementById('selector-panel-grid').addEventListener('click', e => {
  const card = e.target.closest('.panel-card');
  if (card) selectItem(parseInt(card.dataset.index, 10));
});

// Restore mode from URL
const params = new URLSearchParams(location.search);
const modeParam = params.get('mode');
if (modeParam === 'cpu') switchMode('cpu');
</script>

</Layout>
